# Pinned native toolchain versions - the single source of truth.
#
# The design requires these be pinned explicitly and that the compiled WASM
# artifact be cached keyed on them, because an OCCT build from scratch is slow
# enough that an uncached step discourages running it. MVP-0 also records these
# values alongside its measurements so results are attributable to a build, and
# so MVP-1's document manifest has a kernelVersion to reference.
#
# Sourced by every script in scripts/ and by CI. Change here, nowhere else.
#
# All names carry a WEBCAD_ prefix deliberately: `emsdk_env.sh` unsets its own
# EMSDK_VERSION when activating a toolchain, which silently emptied this value
# before the prefix was added.

# Emscripten SDK. 6.0.7 was the `latest` alias when this was pinned.
WEBCAD_EMSDK_VERSION=6.0.7

# Open CASCADE Technology. V8_0_1 is the current stable release, chosen to pair
# with a current Emscripten rather than mixing a new compiler with an older
# kernel. If the WASM build proves troublesome, V7_9_3 is the documented
# fallback: the 7.x line has more community WASM build precedent.
WEBCAD_OCCT_VERSION=V8_0_1
WEBCAD_OCCT_FALLBACK_VERSION=V7_9_3

# Repository sources.
WEBCAD_EMSDK_REPO=https://github.com/emscripten-core/emsdk.git
WEBCAD_OCCT_REPO=https://github.com/Open-Cascade-SAS/OCCT.git
