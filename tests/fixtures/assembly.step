  'distance_accuracy_value','confusion accuracy');
#350 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7,#1000,#1010));

/* ------------------------------------------------------------------------- */
/* Hand-authored assembly layer.                                             */
/*                                                                           */
/* Tree, with the placement each occurrence carries:                          */
/*                                                                           */
/*   carrier                         (root, no shape of its own)              */
/*     +-- cradle                    at (0, 0, 5), unrotated                  */
/*           +-- bracket  #1         at (20, 0, 0), unrotated                 */
/*           +-- bracket  #2         at (-20, 0, 0), rotated about Z by       */
/*                                   cos=0.6 / sin=0.8, i.e. 53.130102...deg  */
/*                                                                           */
/* Two occurrences of ONE part: the geometry below appears once, and the       */
/* bracket is referenced twice. That is the property MVP-3 exists to preserve. */
/*                                                                           */
/* 'cradle' is a grouping node: its SHAPE_REPRESENTATION holds only axis       */
/* placements and no solid, which is how STEP says "structure, no geometry".   */
/*                                                                           */
/* Rotations use a 3-4-5 direction (0.6, 0.8, 0) so every number in the        */
/* expected transform is exact in binary and a test can assert equality        */
/* rather than a tolerance.                                                   */
/*                                                                           */
/* NOT here, deliberately: a mirrored occurrence. A NEXT_ASSEMBLY_USAGE_       */
/* OCCURRENCE places its child through ITEM_DEFINED_TRANSFORMATION between two */
/* AXIS2_PLACEMENT_3D, both right-handed by construction, so no product-       */
/* structure occurrence can express a reflection. Mirrors reach a reader by    */
/* another route (a MAPPED_ITEM with a CARTESIAN_TRANSFORMATION_OPERATOR_3D),  */
/* which is not an assembly occurrence and is left to the third-party fixture. */
/* ------------------------------------------------------------------------- */

/* -- carrier: the root product -------------------------------------------- */
#1000 = PRODUCT('carrier','carrier','',(#8));
#1001 = PRODUCT_DEFINITION_FORMATION('','',#1000);
#1002 = PRODUCT_DEFINITION('design','',#1001,#9);
#1003 = PRODUCT_DEFINITION_SHAPE('','',#1002);
#1004 = SHAPE_REPRESENTATION('carrier',(#1020,#1030),#345);
#1005 = SHAPE_DEFINITION_REPRESENTATION(#1003,#1004);

/* -- cradle: a subassembly with children and no shape of its own ----------- */
#1010 = PRODUCT('cradle','cradle','',(#8));
#1011 = PRODUCT_DEFINITION_FORMATION('','',#1010);
#1012 = PRODUCT_DEFINITION('design','',#1011,#9);
#1013 = PRODUCT_DEFINITION_SHAPE('','',#1012);
#1014 = SHAPE_REPRESENTATION('cradle',(#1024,#1040,#1050),#345);
#1015 = SHAPE_DEFINITION_REPRESENTATION(#1013,#1014);

/* -- placements ------------------------------------------------------------ */
/* Shared direction and origin entities: identity orientation, world origin.  */
#1021 = CARTESIAN_POINT('',(0.,0.,0.));
#1022 = DIRECTION('',(0.,0.,1.));
#1023 = DIRECTION('',(1.,0.,0.));

#1020 = AXIS2_PLACEMENT_3D('carrier origin',#1021,#1022,#1023);
#1024 = AXIS2_PLACEMENT_3D('cradle origin',#1021,#1022,#1023);

/* cradle inside carrier: lifted 5 mm in Z */
#1030 = AXIS2_PLACEMENT_3D('cradle in carrier',#1031,#1022,#1023);
#1031 = CARTESIAN_POINT('',(0.,0.,5.));

/* bracket occurrence 1: translated only */
#1040 = AXIS2_PLACEMENT_3D('bracket 1 in cradle',#1041,#1022,#1023);
#1041 = CARTESIAN_POINT('',(20.,0.,0.));

/* bracket occurrence 2: translated and rotated about Z */
#1050 = AXIS2_PLACEMENT_3D('bracket 2 in cradle',#1051,#1022,#1052);
#1051 = CARTESIAN_POINT('',(-20.,0.,0.));
#1052 = DIRECTION('',(0.6,0.8,0.));

/* -- occurrence 1 of 3: cradle in carrier ---------------------------------- */
#1060 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','cradle-1','',#1002,#1012,$);
#1061 = PRODUCT_DEFINITION_SHAPE('','',#1060);
#1062 = CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#1063,#1061);
#1063 = ( REPRESENTATION_RELATIONSHIP('','',#1014,#1004)
REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#1064)
SHAPE_REPRESENTATION_RELATIONSHIP() );
#1064 = ITEM_DEFINED_TRANSFORMATION('','',#1024,#1030);

/* -- occurrence 2 of 3: bracket in cradle, translated ---------------------- */
#1070 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','bracket-1','',#1012,#5,$);
#1071 = PRODUCT_DEFINITION_SHAPE('','',#1070);
#1072 = CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#1073,#1071);
#1073 = ( REPRESENTATION_RELATIONSHIP('','',#10,#1014)
REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#1074)
SHAPE_REPRESENTATION_RELATIONSHIP() );
#1074 = ITEM_DEFINED_TRANSFORMATION('','',#11,#1040);

/* -- occurrence 3 of 3: the same bracket again, rotated -------------------- */
#1080 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('3','bracket-2','',#1012,#5,$);
#1081 = PRODUCT_DEFINITION_SHAPE('','',#1080);
#1082 = CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#1083,#1081);
#1083 = ( REPRESENTATION_RELATIONSHIP('','',#10,#1014)
REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#1084)
SHAPE_REPRESENTATION_RELATIONSHIP() );
#1084 = ITEM_DEFINED_TRANSFORMATION('','',#11,#1050);

/* -- colour --------------------------------------------------------------- */
/* Two styled items, in the part's own context: the whole solid, and one face  */
/* of it. The face colour must win over the part colour where they overlap,    */
/* which is what makes a single coloured face worth having in a fixture.       */
/*                                                                            */
/* An instance-level override is NOT here. It is expressible - AP214 has       */
/* OVER_RIDING_STYLED_ITEM - but nothing in this repository can read a colour  */
/* back yet, so authoring one now would mean committing entities no test can   */
/* check. It is added in group 5, against a reader that can verify it.         */
#1100 = MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION('',(#1101,#1111),#345);

/* the part: blue */
#1101 = STYLED_ITEM('bracket colour',(#1102),#15);
#1102 = PRESENTATION_STYLE_ASSIGNMENT((#1103));
#1103 = SURFACE_STYLE_USAGE(.BOTH.,#1104);
#1104 = SURFACE_SIDE_STYLE('',(#1105));
#1105 = SURFACE_STYLE_FILL_AREA(#1106);
#1106 = FILL_AREA_STYLE('',(#1107));
#1107 = FILL_AREA_STYLE_COLOUR('',#1108);
#1108 = COLOUR_RGB('',0.2,0.4,0.8);

/* one face of the part: amber */
#1111 = STYLED_ITEM('one face',(#1112),#137);
#1112 = PRESENTATION_STYLE_ASSIGNMENT((#1113));
#1113 = SURFACE_STYLE_USAGE(.BOTH.,#1114);
#1114 = SURFACE_SIDE_STYLE('',(#1115));
#1115 = SURFACE_STYLE_FILL_AREA(#1116);
#1116 = FILL_AREA_STYLE('',(#1117));
#1117 = FILL_AREA_STYLE_COLOUR('',#1118);
#1118 = COLOUR_RGB('',0.9,0.6,0.1);

ENDSEC;
END-ISO-10303-21;
